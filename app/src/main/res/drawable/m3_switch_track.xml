<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_sys_color_primary" />
            <corners android:radius="16dp" />
            <size android:width="52dp" android:height="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_sys_color_surface_container_highest" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/m3_sys_color_outline" />
            <size android:width="52dp" android:height="32dp" />
        </shape>
    </item>
</selector>
