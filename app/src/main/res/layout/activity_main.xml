<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/m3_sys_color_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- ================================================================= -->
        <!-- بخش هدر بر اساس Material 3 Top App Bar & Hero                     -->
        <!-- ================================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="28dp">

            <!-- آیکون برنامه در کانتینر ترنزیشنال Material 3 -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_m3_icon_box_primary">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_launcher"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>

            <!-- عنوان بزرگ Material 3 Headline Medium -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/app_name"
                android:textColor="@color/m3_sys_color_on_surface"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <!-- زیرعنوان Material 3 Body Medium -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_subtitle"
                android:textColor="@color/m3_sys_color_on_surface_variant"
                android:textSize="13.5sp" />

            <!-- نشانگر وضعیت اتصال ماژول (Material 3 Tonal Status Badge) -->
            <LinearLayout
                android:id="@+id/layout_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_m3_badge_inactive"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_dot"
                    android:contentDescription="Status" />

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_inactive"
                    android:textColor="@color/m3_sys_color_on_error_container"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================================================================= -->
        <!-- دسته‌بندی ۱: تنظیمات اصلی (Material 3 Switch Card & Language)      -->
        <!-- ================================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="@string/title_section_settings"
            android:textColor="@color/m3_sys_color_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- کارت ۱: سوئیچ اعلان بازگردانی -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_m3_card"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- آیکون اعلان در نشانگر مربعی گوشه‌گرد Material 3 -->
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_m3_icon_box_secondary"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="@string/title_show_notification" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_show_notification"
                    android:textColor="@color/m3_sys_color_on_surface"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/desc_show_notification"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- سوئیچ اختصاصی سازگار با طراحی Material 3 -->
            <Switch
                android:id="@+id/switch_restore_notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:track="@drawable/m3_switch_track"
                android:thumb="@drawable/m3_switch_thumb" />
        </LinearLayout>

        <!-- کارت ۲: انتخابگر دوطرفه زبان (Material 3 Segmented Toggle Card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_m3_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <!-- آیکون زبان در نشانگر مربعی گوشه‌گرد Material 3 -->
                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_m3_icon_box_tertiary"
                    android:layout_marginEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_translate"
                        android:contentDescription="@string/title_section_language" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_section_language"
                        android:textColor="@color/m3_sys_color_on_surface"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/desc_language_selection"
                        android:textColor="@color/m3_sys_color_on_surface_variant"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- کنترل انتخابگر دوطرفه Material 3 Segmented Button Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_m3_segmented_container"
                android:orientation="horizontal"
                android:padding="3dp">

                <!-- دکمه فارسی -->
                <TextView
                    android:id="@+id/btn_lang_fa"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_m3_segment_active"
                    android:text="@string/lang_persian"
                    android:textColor="@color/m3_sys_color_on_primary_container"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="2dp" />

                <!-- دکمه انگلیسی -->
                <TextView
                    android:id="@+id/btn_lang_en"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_m3_segment_inactive"
                    android:text="@string/lang_english"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="@string/title_section_per_app"
            android:textColor="@color/m3_sys_color_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_m3_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_m3_icon_box_tertiary">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/title_per_app_enable"
                    android:src="@drawable/ic_apps" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_per_app_enable"
                    android:textColor="@color/m3_sys_color_on_surface"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/desc_per_app_enable"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_per_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/m3_switch_thumb"
                android:track="@drawable/m3_switch_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/m3_sys_color_outline_variant" />

            <LinearLayout
                android:id="@+id/row_per_app_choose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_choose_apps"
                    android:textColor="@color/m3_sys_color_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_per_app_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="12.5sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_m3_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_m3_icon_box_secondary">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/title_bypass_mode"
                    android:src="@drawable/ic_block" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_bypass_mode"
                    android:textColor="@color/m3_sys_color_on_surface"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/desc_bypass_mode"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_bypass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/m3_switch_thumb"
                android:track="@drawable/m3_switch_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/m3_sys_color_outline_variant" />

            <LinearLayout
                android:id="@+id/row_bypass_choose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_choose_apps"
                    android:textColor="@color/m3_sys_color_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_bypass_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="12.5sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="@string/title_section_filters"
            android:textColor="@color/m3_sys_color_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_m3_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_m3_icon_box_primary">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/title_redirect"
                    android:src="@drawable/ic_link" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_redirect"
                    android:textColor="@color/m3_sys_color_on_surface"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/desc_redirect"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_redirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/m3_switch_thumb"
                android:track="@drawable/m3_switch_track" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_m3_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_m3_icon_box_secondary">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/title_builtin_exceptions"
                    android:src="@drawable/ic_shield_check" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_builtin_exceptions"
                    android:textColor="@color/m3_sys_color_on_surface"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/desc_builtin_exceptions"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_builtin_exceptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/m3_switch_thumb"
                android:track="@drawable/m3_switch_track" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_exceptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_m3_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/bg_m3_ripple_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_m3_icon_box_tertiary">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/title_excluded_sites"
                    android:src="@drawable/ic_public" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_excluded_sites"
                    android:textColor="@color/m3_sys_color_on_surface"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/desc_excluded_sites"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_exceptions_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="@color/m3_sys_color_on_surface_variant"
                android:textSize="12.5sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- ================================================================= -->
        <!-- دسته‌بندی ۲: نحوه کارکرد ماژول (Material 3 Info Card)               -->
        <!-- ================================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="@string/title_section_how_it_works"
            android:textColor="@color/m3_sys_color_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_m3_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_m3_icon_box_tertiary"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_info"
                        android:contentDescription="Info" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_how_it_works"
                    android:textColor="@color/m3_sys_color_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/desc_how_it_works"
                android:textColor="@color/m3_sys_color_on_surface_variant"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- ================================================================= -->
        <!-- دسته‌بندی ۴: مخزن رسمی گیت‌هاب (Material 3 Interactive Card)      -->
        <!-- ================================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:text="@string/title_section_community"
            android:textColor="@color/m3_sys_color_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/card_github"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_m3_card"
            android:foreground="@drawable/bg_m3_ripple_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- نشان Material 3 برای گیت‌هاب -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_m3_icon_box_primary"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_github"
                    android:contentDescription="GitHub" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_github"
                    android:textColor="@color/m3_sys_color_on_surface"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/desc_github"
                    android:textColor="@color/m3_sys_color_on_surface_variant"
                    android:textSize="12sp" />

                <!-- تگ کوچک مخزن گیت‌هاب -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_m3_chip"
                    android:text="@string/github_repo_tag"
                    android:textColor="@color/m3_sys_color_primary"
                    android:textSize="10.5sp"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_open_in_new"
                android:contentDescription="Open in Browser" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
