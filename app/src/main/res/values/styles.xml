<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GhostShare" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/m3_sys_color_background</item>
        <item name="android:colorBackground">@color/m3_sys_color_background</item>
        <item name="colorPrimary">@color/m3_sys_color_primary</item>
        <item name="android:colorPrimary">@color/m3_sys_color_primary</item>
        <item name="android:colorAccent">@color/m3_sys_color_primary</item>
        <item name="android:statusBarColor">@color/m3_sys_color_background</item>
        <item name="android:navigationBarColor">@color/m3_sys_color_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.GhostShare.Activity</item>
    </style>

    <style name="Animation.GhostShare.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/ghost_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/ghost_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/ghost_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/ghost_close_exit</item>
    </style>

</resources>
