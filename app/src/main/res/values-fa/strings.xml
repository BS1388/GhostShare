    <string name="title_section_per_app">تنظیمات هر برنامه</string>
    <string name="title_per_app_enable">فعال‌سازی برای برنامه‌های انتخابی</string>
    <string name="desc_per_app_enable">فقط لینک‌هایی که از برنامه‌های انتخاب‌شده کپی می‌شوند پاک‌سازی می‌شوند و بقیه‌ی برنامه‌ها دست‌نخورده می‌مانند.</string>
    <string name="title_bypass_mode">حالت عبور (Bypass)</string>
    <string name="desc_bypass_mode">لینک‌هایی که از برنامه‌های انتخاب‌شده کپی می‌شوند هرگز پاک‌سازی نمی‌شوند و بقیه مثل قبل کار می‌کنند.</string>
