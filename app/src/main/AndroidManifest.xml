<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ir.ghostshare">

    <permission
        android:name="io.github.bs1388.ghostshare.permission.CONTROL"
        android:protectionLevel="signature" />

    <uses-permission android:name="io.github.bs1388.ghostshare.permission.CONTROL" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.GhostShare">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedentry"
            android:value="ir.ghostshare.HookEntry" />
        <meta-data
            android:name="xposeddescription"
            android:value="Automatically strips tracking parameters (utm_*, igsh, si, fbclid, gclid, etc.) from copied links across the entire OS." />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="uiMode|screenSize|orientation"
            android:theme="@style/Theme.GhostShare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:configChanges="uiMode|screenSize|orientation|layoutDirection"
            android:exported="false"
            android:theme="@style/Theme.GhostShare" />

        <receiver
            android:name=".NotificationReceiver"
            android:exported="false" />

        <service
            android:name=".RestoreTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification_ghost"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
